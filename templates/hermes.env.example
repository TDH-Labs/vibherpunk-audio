# ~/.hermes/.env — the voice build needs exactly two entries.
# This file must be chmod 600. Values are never printed or logged
# by any part of the build.

# Gateway key for the Hermes API server (the back office worker).
# Generate it yourself:  openssl rand -hex 32
# It must match the key the Hermes gateway is configured with.
API_SERVER_KEY=

# Lane + worker model access. The HUMAN obtains this key from their
# own OpenCode Go subscription account (see INSTALL-FOR-AGENTS.md,
# human step 3) and pastes it here — the installing agent never
# handles the login.
OPENCODE_GO_API_KEY=
